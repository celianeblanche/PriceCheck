<?xml version="1.0" encoding="utf-8" ?>
<!-- Écran Accueil : recherche par nom, scan ou saisie du code-barres, derniers produits. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PriceCheck.Models"
             x:Class="PriceCheck.Pages.AccueilPage"
             Title="Accueil"
             BackgroundColor="#F8FAFC"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,48,24,24">

            <!-- Lien de déconnexion, en haut à droite.
                 Padding="8" agrandit la zone qu'on peut toucher avec le doigt. -->
            <Label Text="Se déconnecter" FontSize="14" FontFamily="InterBold"
                   TextColor="#1D4ED8" HorizontalOptions="End" Padding="8" Margin="0,0,-8,8">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSeDeconnecterTapped" />
                </Label.GestureRecognizers>
            </Label>

            <Label Text="Comparer un prix" Style="{StaticResource TitrePrincipal}" />

            <!-- NOUVEAU : recherche par nom.
                 TextChanged : appelle OnRechercheModifiee à chaque lettre tapée.
                 ReturnType="Search" : le bouton du clavier affiche une loupe. -->
            <Label Text="Rechercher un produit" FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource PcTexte}" Margin="0,24,0,8" />
            <Border Style="{StaticResource CadreChamp}">
                <Entry x:Name="ChampRecherche" Placeholder="Ex. lait, riz, huile" ReturnType="Search"
                       Style="{StaticResource ChampSaisie}" TextChanged="OnRechercheModifiee" />
            </Border>

            <!-- NOUVEAU : résultats de la recherche (cachés tant qu'on ne tape rien) -->
            <VerticalStackLayout x:Name="BlocResultats" IsVisible="False" Margin="0,24,0,0">
                <Label Text="Résultats" Style="{StaticResource TitreSection}" />

                <!-- Une carte par produit trouvé. Toucher une carte ouvre la comparaison.
                     (Même modèle de carte que "Derniers produits" plus bas.) -->
                <VerticalStackLayout x:Name="ListeResultats" Spacing="12" Margin="0,16,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProduitRecent">
                            <Border Style="{StaticResource Carte}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProduitTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nom}"
                                           Style="{StaticResource SousTitre}" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Enseigne}"
                                           Style="{StaticResource TexteSecondaire}" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Prix}"
                                           Style="{StaticResource PrixListe}" HorizontalOptions="End" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Anciennete}"
                                           Style="{StaticResource PetitTexte}" HorizontalOptions="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Affiché seulement s'il n'y a aucun résultat -->
                <VerticalStackLayout x:Name="AucunResultat" IsVisible="False" Margin="0,8,0,0">
                    <Label Text="Aucun produit trouvé" Style="{StaticResource SousTitre}" />
                    <Label Text="Scannez son code-barres pour l'ajouter à la base."
                           Style="{StaticResource TexteSecondaire}" Margin="0,4,0,0" />
                    <Button Text="Scanner un produit" Style="{StaticResource BoutonSecondaire}"
                            Margin="0,16,0,0" Clicked="OnScannerClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- NOUVEAU : tout le reste de l'Accueil est regroupé ici,
                 pour être caché pendant qu'on affiche des résultats de recherche. -->
            <VerticalStackLayout x:Name="BlocAccueil">

                <!-- Bouton principal (le seul de l'écran) -->
                <Button Text="Scanner un produit" Style="{StaticResource BoutonPrincipal}"
                        Margin="0,24,0,0" Clicked="OnScannerClicked" />

                <!-- Saisie manuelle du code-barres -->
                <Label Text="Ou saisissez le code-barres" FontSize="14" FontAttributes="Bold"
                       TextColor="{StaticResource PcTexte}" Margin="0,24,0,8" />
                <Border x:Name="CadreCode" Style="{StaticResource CadreChamp}">
                    <!-- Numeric : clavier de chiffres. MaxLength : 13 caractères au maximum. -->
                    <Entry x:Name="ChampCode" Placeholder="13 chiffres" Keyboard="Numeric"
                           MaxLength="13" Style="{StaticResource ChampSaisie}" />
                </Border>
                <Label x:Name="ErreurCode" Style="{StaticResource MessageErreur}"
                       IsVisible="False" Margin="0,4,0,0" />

                <Button Text="Comparer" Style="{StaticResource BoutonSecondaire}"
                        Margin="0,16,0,0" Clicked="OnComparerClicked" />

                <!-- Derniers produits -->
                <Label Text="Derniers produits" Style="{StaticResource TitreSection}" Margin="0,32,0,0" />

                <!-- BindableLayout : répète le modèle ci-dessous pour chaque produit de la liste.
                     La liste est donnée par le code (.cs). {Binding Nom} = "affiche la propriété Nom du produit". -->
                <VerticalStackLayout x:Name="ListeProduits" Spacing="12" Margin="0,16,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ProduitRecent">
                            <Border Style="{StaticResource Carte}">
                                <!-- NOUVEAU : toucher la carte ouvre la comparaison du produit -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnProduitTapped" />
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                                    <Label Grid.Row="0" Grid.Column="0" Text="{Binding Nom}"
                                           Style="{StaticResource SousTitre}" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="{Binding Enseigne}"
                                           Style="{StaticResource TexteSecondaire}" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Prix}"
                                           Style="{StaticResource PrixListe}" HorizontalOptions="End" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Anciennete}"
                                           Style="{StaticResource PetitTexte}" HorizontalOptions="End" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>