<?xml version="1.0" encoding="utf-8" ?>
<!-- Écran Inscription : même structure que Connexion, avec un bouton principal différent. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PriceCheck.Controls"
             x:Class="PriceCheck.Pages.InscriptionPage"
             Title="Inscription"
             BackgroundColor="{StaticResource PcSurface}"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <!-- MODIFIÉ : marge du haut réduite (40 au lieu de 72) pour faire de la place à la flèche -->
        <VerticalStackLayout Padding="24,40,24,24">

            <!-- NOUVEAU : flèche retour (ramène à l'écran Connexion) -->
            <controls:BarreRetour />

            <!-- Logo provisoire + nom de l'application -->
            <HorizontalStackLayout Spacing="12" Margin="0,16,0,0">
                <Border BackgroundColor="{StaticResource PcPrincipale}"
                        StrokeThickness="0"
                        WidthRequest="48" HeightRequest="48">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Label Text="P" TextColor="White" FontSize="24" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="PriceCheck" Style="{StaticResource TitreSection}" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="Créer un compte" Style="{StaticResource TitrePrincipal}" Margin="0,32,0,0" />
            <Label Text="Quelques secondes suffisent" Style="{StaticResource TexteSecondaire}" Margin="0,8,0,0" />

            <!-- Champ adresse e-mail -->
            <Label Text="Adresse e-mail" FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource PcTexte}" Margin="0,32,0,8" />
            <Border x:Name="CadreEmail" Style="{StaticResource CadreChamp}">
                <Entry x:Name="ChampEmail" Placeholder="nom@exemple.com" Keyboard="Email"
                       Style="{StaticResource ChampSaisie}" />
            </Border>
            <Label x:Name="ErreurEmail" Style="{StaticResource MessageErreur}"
                   IsVisible="False" Margin="0,4,0,0" />

            <!-- Champ mot de passe (avec "Afficher / Masquer") -->
            <Label Text="Mot de passe" FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource PcTexte}" Margin="0,16,0,8" />
            <Border x:Name="CadreMotDePasse" Style="{StaticResource CadreChamp}">
                <Grid ColumnDefinitions="*,Auto">
                    <Entry x:Name="ChampMotDePasse" Grid.Column="0" Placeholder="8 caractères minimum"
                           IsPassword="True" Style="{StaticResource ChampSaisie}" />
                    <Label x:Name="BoutonAfficher" Grid.Column="1" Text="Afficher"
                           Style="{StaticResource LienTexte}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAfficherMotDePasseTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>
            </Border>
            <Label x:Name="ErreurMotDePasse" Style="{StaticResource MessageErreur}"
                   IsVisible="False" Margin="0,4,0,0" />

            <!-- Un seul bouton principal par écran, puis le bouton secondaire -->
            <Button Text="Créer mon compte" Style="{StaticResource BoutonPrincipal}"
                    Margin="0,32,0,0" Clicked="OnCreerMonCompteClicked" />
            <Button Text="J'ai déjà un compte" Style="{StaticResource BoutonSecondaire}"
                    Margin="0,16,0,0" Clicked="OnDejaUnCompteClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>