<?xml version="1.0" encoding="utf-8" ?>
<!-- Écran Scanner : fond sombre (économie d'énergie sur écran OLED), cadre caméra, panneau blanc de saisie manuelle. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PriceCheck.Pages.ScannerPage"
             Title="Scanner"
             BackgroundColor="#1E293B"
             Shell.NavBarIsVisible="False">

    <!-- Grid à 2 lignes : la 1re (*) prend la place restante (zone caméra), la 2e (Auto) la taille du panneau. -->
    <Grid RowDefinitions="*,Auto">

        <!-- Cadre de la caméra : on appuie dessus pour "activer la caméra" -->
        <Border Grid.Row="0" BackgroundColor="Transparent" Stroke="White" StrokeThickness="2"
                WidthRequest="280" HeightRequest="200"
                HorizontalOptions="Center" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCadreCameraTapped" />
            </Border.GestureRecognizers>

            <!-- MODIFIÉ : ZoneCamera est un conteneur dans lequel le code (.cs) ajoute la vue caméra
                 à chaque activation, et la retire quand on quitte l'écran.
                 Les éléments d'un Grid sans lignes sont empilés : le texte passe PAR-DESSUS la caméra. -->
            <Grid x:Name="ZoneCamera">
                <!-- Texte affiché tant que la caméra est éteinte -->
                <Label x:Name="MessageCamera" Text="Appuyez pour activer la caméra" TextColor="White" FontSize="16"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center"
                       VerticalOptions="Center" Margin="24" />
            </Grid>
        </Border>

        <!-- Panneau blanc du bas : saisie manuelle. Coins arrondis seulement en haut ("12,12,0,0"). -->
        <Border Grid.Row="1" BackgroundColor="White" StrokeThickness="0" Padding="24">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12,12,0,0" />
            </Border.StrokeShape>
            <VerticalStackLayout>
                <Label Text="Saisie manuelle" Style="{StaticResource SousTitre}" />

                <Border x:Name="CadreCode" Style="{StaticResource CadreChamp}" Margin="0,16,0,0">
                    <Entry x:Name="ChampCode" Placeholder="13 chiffres" Keyboard="Numeric"
                           MaxLength="13" Style="{StaticResource ChampSaisie}" />
                </Border>
                <Label x:Name="ErreurCode" Style="{StaticResource MessageErreur}"
                       IsVisible="False" Margin="0,4,0,0" />

                <Button Text="Comparer" Style="{StaticResource BoutonPrincipal}"
                        Margin="0,16,0,0" Clicked="OnComparerClicked" />
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>