<?xml version="1.0" encoding="utf-8" ?>
<!-- Écran Ajouter un relevé : formulaire enseigne + prix. Pas de barre du bas (TabBarIsVisible=False). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:PriceCheck.Controls"
             x:Class="PriceCheck.Pages.RelevePage"
             Title="Ajouter un relevé"
             BackgroundColor="#F8FAFC"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <!-- MODIFIÉ : marge du haut réduite (40 au lieu de 56) pour faire de la place à la flèche -->
        <VerticalStackLayout Padding="24,40,24,24">

            <!-- NOUVEAU : flèche retour -->
            <controls:BarreRetour />

            <Label Text="Ajouter un relevé" Style="{StaticResource TitrePrincipal}" Margin="0,8,0,0" />
            <!-- Nom du produit concerné (rempli par le code .cs) -->
            <Label x:Name="NomProduit" Style="{StaticResource TexteSecondaire}" Margin="0,8,0,0" />

            <!-- Champ Enseigne -->
            <Label Text="Enseigne" FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource PcTexte}" Margin="0,32,0,8" />
            <Border Style="{StaticResource CadreChamp}">
                <!-- TextChanged : appelle OnChampModifie à chaque lettre tapée -->
                <Entry x:Name="ChampEnseigne" Placeholder="Ex. Super Plus"
                       Style="{StaticResource ChampSaisie}" TextChanged="OnChampModifie" />
            </Border>

            <!-- Champ Prix -->
            <Label Text="Prix (FCFA)" FontSize="14" FontAttributes="Bold"
                   TextColor="{StaticResource PcTexte}" Margin="0,16,0,8" />
            <Border x:Name="CadrePrix" Style="{StaticResource CadreChamp}">
                <Entry x:Name="ChampPrix" Placeholder="Ex. 1 250" Keyboard="Numeric"
                       Style="{StaticResource ChampSaisie}" TextChanged="OnChampModifie" />
            </Border>
            <Label x:Name="ErreurPrix" Style="{StaticResource MessageErreur}"
                   IsVisible="False" Margin="0,4,0,0" />

            <!-- Information : la date n'est pas saisie par l'utilisatrice -->
            <Label Text="Date : aujourd'hui, ajoutée automatiquement"
                   Style="{StaticResource TexteSecondaire}" Margin="0,16,0,0" />

            <!-- Désactivé au départ : activé par le code quand le formulaire est valide -->
            <Button x:Name="BoutonEnregistrer" Text="Enregistrer le relevé"
                    Style="{StaticResource BoutonPrincipal}" IsEnabled="False"
                    Margin="0,32,0,0" Clicked="OnEnregistrerClicked" />
            <Button Text="Annuler" Style="{StaticResource BoutonSecondaire}"
                    Margin="0,16,0,0" Clicked="OnAnnulerClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>