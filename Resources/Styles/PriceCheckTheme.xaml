<?xml version="1.0" encoding="UTF-8" ?>
<!-- Charte graphique de PriceCheck : couleurs et styles réutilisables. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- COULEURS (mêmes codes HEX que les maquettes) -->
    <Color x:Key="PcPrincipale">#1D4ED8</Color>
    <Color x:Key="PcPrincipaleAppuyee">#1E40AF</Color>
    <Color x:Key="PcPrincipaleTeinte">#EAF0FF</Color>
    <Color x:Key="PcSecondaire">#1E293B</Color>
    <Color x:Key="PcSucces">#15803D</Color>
    <Color x:Key="PcSuccesTeinte">#E8F6EE</Color>
    <Color x:Key="PcAvertissement">#B45309</Color>
    <Color x:Key="PcAvertissementTeinte">#FEF3C7</Color>
    <Color x:Key="PcErreur">#DC2626</Color>
    <Color x:Key="PcErreurTeinte">#FDECEC</Color>
    <Color x:Key="PcFond">#F8FAFC</Color>
    <Color x:Key="PcSurface">#FFFFFF</Color>
    <Color x:Key="PcBordure">#E2E8F0</Color>
    <Color x:Key="PcBordureChamp">#94A3B8</Color>
    <Color x:Key="PcTexte">#0F172A</Color>
    <Color x:Key="PcTexteSecondaire">#475569</Color>
    <Color x:Key="PcPlaceholder">#64748B</Color>
    <Color x:Key="PcDesactiveTexte">#94A3B8</Color>

    <!-- STYLES DE TEXTE -->
    <Style x:Key="TitrePrincipal" TargetType="Label">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PcTexte}" />
    </Style>

    <Style x:Key="TitreSection" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PcTexte}" />
    </Style>

    <Style x:Key="SousTitre" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PcTexte}" />
    </Style>

    <Style x:Key="TexteCourant" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource PcTexte}" />
    </Style>

    <Style x:Key="TexteSecondaire" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource PcTexteSecondaire}" />
    </Style>

    <Style x:Key="PetitTexte" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource PcTexteSecondaire}" />
    </Style>

    <Style x:Key="MessageErreur" TargetType="Label">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource PcErreur}" />
    </Style>

    <Style x:Key="LienTexte" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PcPrincipale}" />
    </Style>

    <Style x:Key="PrixListe" TargetType="Label">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource PcTexte}" />
    </Style>

    <!-- BOUTONS (hauteur 52, rayon 12) -->
    <Style x:Key="BoutonPrincipal" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PcPrincipale}" />
        <Setter Property="TextColor" Value="{StaticResource PcSurface}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PcPrincipaleAppuyee}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PcBordure}" />
                            <Setter Property="TextColor" Value="{StaticResource PcDesactiveTexte}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="BoutonSecondaire" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource PcSurface}" />
        <Setter Property="TextColor" Value="{StaticResource PcPrincipale}" />
        <Setter Property="BorderColor" Value="{StaticResource PcPrincipale}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HeightRequest" Value="52" />
    </Style>

    <!-- CARTES ET CHAMPS -->
    <Style x:Key="Carte" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PcSurface}" />
        <Setter Property="Stroke" Value="{StaticResource PcBordure}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CadreChamp" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource PcSurface}" />
        <Setter Property="Stroke" Value="{StaticResource PcBordureChamp}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="12" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ChampSaisie" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource PcTexte}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource PcPlaceholder}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

</ResourceDictionary>
